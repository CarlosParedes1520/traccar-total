}

body:json {
  {
  "id": 1,
  "uniqueId": "ORDER001",
  "description": "Updated delivery order",
  "fromAddress": "123 Main St, City",
  "toAddress": "456 Oak Ave, City",
  "attributes": {}
}
}

auth:basic {
  username: {{email}}
  password: {{password}}
}

