meta {
  name: Create User
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/users
  body: json
  auth: basic
}

headers {
  Content-Type: application/json
}

body:json {
  {
  "name": "Test User",
  "email": "test@example.com",
  "password": "password123",
  "readonly": false,
  "administrator": false,
  "disabled": false,
  "deviceLimit": -1,
  "userLimit": 0,
  "deviceReadonly": false,
  "limitCommands": false,
  "disableReports": false,
  "fixedEmail": false,
  "attributes": {}
}
}

auth:basic {
  username: {{email}}
  password: {{password}}
}

