meta {
  name: Change Password
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/password
  body: form-urlencoded
  auth: basic
}

headers {
  Content-Type: application/x-www-form-urlencoded
}

body:form-urlencoded {
  oldPassword: oldpassword
  newPassword: newpassword
}

auth:basic {
  username: {{email}}
  password: {{password}}
}

