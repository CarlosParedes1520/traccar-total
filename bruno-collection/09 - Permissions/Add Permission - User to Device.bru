meta {
  name: Add Permission - User to Device
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/permissions
  body: json
  auth: basic
}

headers {
  Content-Type: application/json
}

body:json {
  {
  "userId": {{userId}},
  "deviceId": {{deviceId}}
}
}

auth:basic {
  username: {{email}}
  password: {{password}}
}

