meta {
  name: Add Permission - Device to Notification
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/permissions
  body: json
  auth: basic
}

headers {
  Content-Type: application/json
}

body:json {
  {
  "deviceId": {{deviceId}},
  "notificationId": 1
}
}

auth:basic {
  username: {{email}}
  password: {{password}}
}

